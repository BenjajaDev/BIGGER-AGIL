# Copia este archivo como .env.local. Solo las variables con prefijo VITE_ llegan al navegador:
# nunca pongas secretos aquí.
VITE_API_BASE_URL=/api/v1
# Número de WhatsApp del local en formato internacional sin "+" (ej. 56912345678).
# Si se deja vacío, la carta oculta el botón "Pedir para llevar por WhatsApp".
VITE_WHATSAPP_NUMBER=
