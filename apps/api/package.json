{
  "name": "@bigger/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "admin:pin": "tsx src/scripts/hash-admin-pin.ts"
  },
  "dependencies": {
    "@bigger/shared": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "drizzle-orm": "~0.45.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pdfkit": "^0.17.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "~0.31.10",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "vitest": "^3.2.7"
  }
}
