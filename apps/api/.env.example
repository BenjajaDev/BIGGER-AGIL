# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.
NODE_ENV=development
# 0.0.0.0 permite que las tablets del local se conecten por la red Wi-Fi.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/bigger.db
# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Acceso al módulo de Configuración. Genera ambos valores con: pnpm --filter @bigger/api admin:pin
ADMIN_PIN_HASH=
ADMIN_SESSION_SECRET=
# Carpeta donde se guardan las fotos procesadas de productos y categorías (respáldala).
UPLOADS_DIR=./data/uploads
# Zona horaria del local: define en qué día empieza y termina cada promoción.
BUSINESS_TIMEZONE=America/Santiago
# Impresora térmica de 58 mm: imprime la comanda de cada pedido nuevo.
# PRINTER_PATH es el dispositivo donde Windows o Linux deja la impresora:
#   Bluetooth: COM5 (Windows) o /dev/rfcomm0 (Linux)
#   USB:       /dev/usb/lp0 (Linux) o \\localhost\NOMBRE (impresora compartida en Windows)
PRINTER_ENABLED=false
PRINTER_PATH=
# Tabla de caracteres para tildes y ñ: cp858, wpc1252 o ascii (sin tildes).
PRINTER_CODEPAGE=cp858
PRINTER_COLUMNS=32
PRINTER_FEED_LINES=4
PRINTER_CUT=false
