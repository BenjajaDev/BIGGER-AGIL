@@ -0,0 +1,250 @@
+import type { Check } from '@bigger/shared';
+import { CircleCheck, X } from 'lucide-react';
+import { useEffect, useId, useRef, useState } from 'react';
+import { FieldError } from '../../../components/form/Field';
+import { Button } from '../../../components/ui/Button';
+import { formatClp } from '../../../lib/format';
+import {
+  INITIAL_PAYMENT_DRAFT,
+  paymentBlocker,
+  paymentTotals,
+  toPaymentInput,
+  type PaymentDraft,
+} from '../payment-draft';
+import { PAYMENT_METHOD_PRESENTATION } from '../payment-presentation';
+import { usePay, useSetSplit } from '../useChecks';
+import styles from './PaymentDialog.module.css';
+import {
+  CashField,
+  ItemPicker,
+  MethodPicker,
+  ModePicker,
+  SplitPicker,
+  TipField,
+} from './PaymentSections';
+
+export interface PaymentDialogProps {
+  check: Check;
+  open: boolean;
+  onClose: () => void;
+}
+
+interface PaymentResult {
+  check: Check;
+  changeClp: number | null;
+  totalClp: number;
+}
+
+/**
+ * Native modal `<dialog>`: focus trap, inert background and Esc come from the browser. The
+ * draft only holds choices; every amount is recalculated from the live check.
+ */
+export function PaymentDialog({ check, open, onClose }: PaymentDialogProps) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const titleId = useId();
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    if (open && !dialog.open) dialog.showModal();
+    if (!open && dialog.open) dialog.close();
+  }, [open]);
+
+  const title = check.tableLabel ? `Cobrar ${check.tableLabel}` : 'Cobrar pedido';
+
+  return (
+    <dialog ref={dialogRef} className={styles.dialog} aria-labelledby={titleId} onClose={onClose}>
+      <div className={styles.head}>
+        <div>
+          <h2 id={titleId} className={styles.title}>
+            {title}
+          </h2>
+          <p className={styles.balance}>Saldo {formatClp(check.balanceClp)}</p>
+        </div>
+        <button type="button" className={styles.close} onClick={onClose} aria-label="Cerrar">
+          <X size={22} aria-hidden="true" />
+        </button>
+      </div>
+      {open && <PaymentForm check={check} onClose={onClose} />}
+    </dialog>
+  );
+}
+
+function PaymentForm({ check, onClose }: { check: Check; onClose: () => void }) {
+  const pay = usePay();
+  const split = useSetSplit();
+  const [draft, setDraft] = useState<PaymentDraft>(INITIAL_PAYMENT_DRAFT);
+  const [result, setResult] = useState<PaymentResult | null>(null);
+  const update = (change: Partial<PaymentDraft>) => {
+    setDraft((current) => ({ ...current, ...change }));
+  };
+
+  if (result) {
+    return (
+      <PaymentDone
+        result={result}
+        onAnother={() => {
+          setResult(null);
+          setDraft(INITIAL_PAYMENT_DRAFT);
+          pay.reset();
+        }}
+        onClose={onClose}
+      />
+    );
+  }
+
+  const totals = paymentTotals(check, draft);
+  const blocker = paymentBlocker(check, draft);
+  const error = pay.error?.message ?? split.error?.message ?? null;
+
+  const submit = () => {
+    pay.mutate(
+      { checkId: check.id, input: toPaymentInput(check, draft) },
+      {
+        onSuccess: (updated) => {
+          setResult({ check: updated, changeClp: totals.changeClp, totalClp: totals.dueClp });
+        },
+      },
+    );
+  };
+
+  return (
+    <>
+      <div className={styles.body}>
+        <ModePicker
+          value={draft.mode}
+          onChange={(mode) => {
+            update({ mode });
+          }}
+        />
+        {draft.mode === 'items' && (
+          <ItemPicker
+            check={check}
+            units={draft.units}
+            onChange={(units) => {
+              update({ units });
+            }}
+          />
+        )}
+        {draft.mode === 'equal' && (
+          <SplitPicker
+            check={check}
+            isPending={split.isPending}
+            onSplit={(parts) => {
+              split.mutate({ checkId: check.id, parts });
+            }}
+          />
+        )}
+        <MethodPicker
+          value={draft.method}
+          onChange={(method) => {
+            update({ method });
+          }}
+        />
+        <TipField
+          method={draft.method}
+          enabled={draft.tipEnabled}
+          tipClp={totals.tipClp}
+          onToggle={(tipEnabled) => {
+            update({ tipEnabled, customTipClp: null });
+          }}
+          onChange={(customTipClp) => {
+            update({ customTipClp });
+          }}
+        />
+        {draft.method === 'cash' && (
+          <CashField
+            dueClp={totals.dueClp}
+            receivedClp={draft.receivedClp}
+            changeClp={totals.changeClp}
+            onChange={(receivedClp) => {
+              update({ receivedClp });
+            }}
+          />
+        )}
+      </div>
+
+      <div className={styles.footer}>
+        <dl className={styles.totals}>
+          <div>
+            <dt>Consumo</dt>
+            <dd>{formatClp(totals.amountClp)}</dd>
+          </div>
+          <div>
+            <dt>Propina</dt>
+            <dd>{formatClp(totals.tipClp)}</dd>
+          </div>
+          <div className={styles.due}>
+            <dt>Total a cobrar</dt>
+            <dd>{formatClp(totals.dueClp)}</dd>
+          </div>
+          {totals.changeClp !== null && (
+            <div className={styles.due}>
+              <dt>Vuelto</dt>
+              <dd>{formatClp(totals.changeClp)}</dd>
+            </div>
+          )}
+        </dl>
+        {error && (
+          <div role="alert">
+            <FieldError message={error} />
+          </div>
+        )}
+        <p className={styles.blocker} role="status">
+          {blocker ?? ''}
+        </p>
+        <Button
+          variant="primary"
+          size="lg"
+          fullWidth
+          disabled={blocker !== null || pay.isPending}
+          onClick={submit}
+        >
+          {pay.isPending
+            ? 'Cobrando…'
+            : `Cobrar ${formatClp(totals.dueClp)}${draft.method ? ` con ${PAYMENT_METHOD_PRESENTATION[draft.method].label}` : ''}`}
+        </Button>
+      </div>
+    </>
+  );
+}
+
+interface PaymentDoneProps {
+  result: PaymentResult;
+  onAnother: () => void;
+  onClose: () => void;
+}
+
+function PaymentDone({ result, onAnother, onClose }: PaymentDoneProps) {
+  const { check, changeClp, totalClp } = result;
+  const closed = check.status === 'closed';
+  return (
+    <div className={styles.done} role="status">
+      <CircleCheck className={styles.doneIcon} size={48} aria-hidden="true" />
+      <p className={styles.doneTitle}>Pago registrado: {formatClp(totalClp)}</p>
+      {changeClp !== null && (
+        <p className={styles.doneChange}>
+          Vuelto <strong>{formatClp(changeClp)}</strong>
+        </p>
+      )}
+      <p className={styles.muted}>
+        {closed
+          ? 'La cuenta quedó pagada y la mesa está libre.'
+          : check.balanceClp === 0
+            ? 'Cuenta pagada: la mesa se libera cuando se entregue todo.'
+            : `Queda un saldo de ${formatClp(check.balanceClp)}.`}
+      </p>
+      <div className={styles.doneActions}>
+        {check.balanceClp > 0 && (
+          <Button variant="secondary" onClick={onAnother}>
+            Cobrar otra parte
+          </Button>
+        )}
+        {/* eslint-disable-next-line jsx-a11y/no-autofocus -- the dialog's next step after paying */}
+        <Button variant="primary" onClick={onClose} autoFocus>
+          Listo
+        </Button>
+      </div>
+    </div>
+  );
+}
diff --git a/apps/web/src/features/checks/components/PaymentSections.tsx b/apps/web/src/features/checks/components/PaymentSections.tsx
new file mode 100644
index 0000000..3c2e1b8
--- /dev/null
+++ b/apps/web/src/features/checks/components/PaymentSections.tsx
@@ -0,0 +1,328 @@
+import {
+  MAX_SPLIT_PARTS,
+  PAYMENT_METHODS,
+  PAYMENT_MODES,
+  type Check,
+  type PaymentMethod,
+  type PaymentMode,
+} from '@bigger/shared';
+import { Minus, Plus } from 'lucide-react';
+import { useId } from 'react';
+import { Checkbox } from '../../../components/form/Checkbox';
+import { MoneyInput } from '../../../components/form/MoneyInput';
+import { Button } from '../../../components/ui/Button';
+import { Chip } from '../../../components/ui/Chip';
+import { formatClp, formatClpSpoken } from '../../../lib/format';
+import { cashShortcuts, selectWholeOrder, tipAllowed } from '../payment-draft';
+import {
+  orderLabel,
+  PAYMENT_METHOD_PRESENTATION,
+  PAYMENT_MODE_LABEL,
+} from '../payment-presentation';
+import styles from './PaymentDialog.module.css';
+
+const toAmount = (value: string): number | null => {
+  const parsed = Number.parseInt(value, 10);
+  return Number.isNaN(parsed) ? null : Math.max(parsed, 0);
+};
+
+export function ModePicker({
+  value,
+  onChange,
+}: {
+  value: PaymentMode;
+  onChange: (mode: PaymentMode) => void;
+}) {
+  const name = useId();
+  return (
+    <fieldset className={styles.group}>
+      <legend className={styles.legend}>¿Qué se paga?</legend>
+      <div className={styles.segmented}>
+        {PAYMENT_MODES.map((mode) => (
+          <label key={mode} className={styles.segment}>
+            <input
+              type="radio"
+              name={name}
+              checked={value === mode}
+              onChange={() => {
+                onChange(mode);
+              }}
+            />
+            {PAYMENT_MODE_LABEL[mode]}
+          </label>
+        ))}
+      </div>
+    </fieldset>
+  );
+}
+
+export interface ItemPickerProps {
+  check: Pick<Check, 'orders' | 'lines'>;
+  units: Readonly<Record<string, number>>;
+  onChange: (units: Record<string, number>) => void;
+}
+
+/** Each person's lines with what is still unpaid; one tap selects everything of an order. */
+export function ItemPicker({ check, units, onChange }: ItemPickerProps) {
+  const billable = check.orders.filter((order) => order.status !== 'cancelled');
+  return (
+    <div className={styles.group}>
+      {billable.map((order, index) => {
+        const lines = check.lines.filter(
+          (line) => line.orderId === order.id && line.paidQuantity < line.quantity,
+        );
+        if (lines.length === 0) return null;
+        const label = orderLabel(order, index);
+        return (
+          <section key={order.id} className={styles.person} aria-label={label}>
+            <div className={styles.personHead}>
+              <span className={styles.personName}>{label}</span>
+              <Button
+                variant="ghost"
+
+                onClick={() => {
+                  onChange(selectWholeOrder(check, units, order.id));
+                }}
+              >
+                Todo lo de {label}
+              </Button>
+            </div>
+            <ul role="list" className={styles.lines}>
+              {lines.map((line) => {
+                const pending = line.quantity - line.paidQuantity;
+                const chosen = units[line.orderItemId] ?? 0;
+                const set = (quantity: number) => {
+                  onChange({ ...units, [line.orderItemId]: quantity });
+                };
+                return (
+                  <li key={line.orderItemId} className={styles.line}>
+                    <span className={styles.lineName}>
+                      {line.productName}
+                      <span className={styles.muted}>
+                        {' '}
+                        · {formatClp(line.unitTotalClp)} c/u
+                        {line.paidQuantity > 0 && ` · ${line.paidQuantity} ya pagado`}
+                      </span>
+                    </span>
+                    <div
+                      className={styles.stepper}
+                      role="group"
+                      aria-label={`Unidades de ${line.productName} a pagar`}
+                    >
+                      <button
+                        type="button"
+                        className={styles.step}
+                        disabled={chosen === 0}
+                        aria-label={`Quitar un ${line.productName}`}
+                        onClick={() => {
+                          set(chosen - 1);
+                        }}
+                      >
+                        <Minus size={18} aria-hidden="true" />
+                      </button>
+                      <output className={styles.stepValue} aria-live="polite">
+                        {chosen} de {pending}
+                      </output>
+                      <button
+                        type="button"
+                        className={styles.step}
+                        disabled={chosen >= pending}
+                        aria-label={`Agregar un ${line.productName}`}
+                        onClick={() => {
+                          set(chosen + 1);
+                        }}
+                      >
+                        <Plus size={18} aria-hidden="true" />
+                      </button>
+                    </div>
+                  </li>
+                );
+              })}
+            </ul>
+          </section>
+        );
+      })}
+    </div>
+  );
+}
+
+const QUICK_PARTS = [2, 3, 4, 5, 6];
+
+export interface SplitPickerProps {
+  check: Pick<Check, 'splitParts' | 'remainingParts' | 'nextPartClp'>;
+  isPending: boolean;
+  onSplit: (parts: number | null) => void;
+}
+
+export function SplitPicker({ check, isPending, onSplit }: SplitPickerProps) {
+  const { splitParts, remainingParts, nextPartClp } = check;
+  if (splitParts !== null && remainingParts !== null && nextPartClp !== null) {
+    const current = Math.min(splitParts - remainingParts + 1, splitParts);
+    return (
+      <div className={styles.splitSummary}>
+        <p>
+          <span className={styles.splitPart}>
+            Parte {current} de {splitParts}
+          </span>{' '}
+          <span className={styles.splitAmount}>{formatClp(nextPartClp)}</span>
+        </p>
+        <Button
+          variant="ghost"
+
+          disabled={isPending}
+          onClick={() => {
+            onSplit(null);
+          }}
+        >
+          Cambiar división
+        </Button>
+      </div>
+    );
+  }
+  return (
+    <fieldset className={styles.group}>
+      <legend className={styles.legend}>¿En cuántas partes?</legend>
+      <div className={styles.chips}>
+        {QUICK_PARTS.filter((parts) => parts <= MAX_SPLIT_PARTS).map((parts) => (
+          <Chip
+            key={parts}
+            pressed={false}
+            disabled={isPending}
+            onClick={() => {
+              onSplit(parts);
+            }}
+          >
+            {parts} personas
+          </Chip>
+        ))}
+      </div>
+    </fieldset>
+  );
+}
+
+export function MethodPicker({
+  value,
+  onChange,
+}: {
+  value: PaymentMethod | null;
+  onChange: (method: PaymentMethod) => void;
+}) {
+  const name = useId();
+  return (
+    <fieldset className={styles.group}>
+      <legend className={styles.legend}>Medio de pago</legend>
+      <div className={styles.methods}>
+        {PAYMENT_METHODS.map((method) => {
+          const { label, icon: Icon } = PAYMENT_METHOD_PRESENTATION[method];
+          return (
+            <label key={method} className={styles.method}>
+              <input
+                type="radio"
+                name={name}
+                checked={value === method}
+                onChange={() => {
+                  onChange(method);
+                }}
+              />
+              <Icon size={28} aria-hidden="true" />
+              {label}
+            </label>
+          );
+        })}
+      </div>
+    </fieldset>
+  );
+}
+
+export interface TipFieldProps {
+  method: PaymentMethod | null;
+  enabled: boolean;
+  tipClp: number;
+  onToggle: (enabled: boolean) => void;
+  onChange: (tipClp: number | null) => void;
+}
+
+export function TipField({ method, enabled, tipClp, onToggle, onChange }: TipFieldProps) {
+  const inputId = useId();
+  if (!tipAllowed(method)) {
+    return (
+      <p className={styles.note}>
+        JUNAEB no admite propina. Si quieren dejarla, regístrala como otro pago en efectivo o
+        débito.
+      </p>
+    );
+  }
+  return (
+    <div className={styles.tip}>
+      <Checkbox
+        label="Agregar propina"
+        description="Sugerida: 10 % de lo que se paga. Puedes cambiar el monto."
+        checked={enabled}
+        onChange={(event) => {
+          onToggle(event.target.checked);
+        }}
+      />
+      {enabled && (
+        <div className={styles.field}>
+          <label htmlFor={inputId} className={styles.legend}>
+            Propina
+          </label>
+          <MoneyInput
+            id={inputId}
+            value={tipClp}
+            onChange={(event) => {
+              onChange(toAmount(event.target.value));
+            }}
+          />
+        </div>
+      )}
+    </div>
+  );
+}
+
+export interface CashFieldProps {
+  dueClp: number;
+  receivedClp: number | null;
+  changeClp: number | null;
+  onChange: (receivedClp: number | null) => void;
+}
+
+export function CashField({ dueClp, receivedClp, changeClp, onChange }: CashFieldProps) {
+  const inputId = useId();
+  return (
+    <div className={styles.group}>
+      <div className={styles.field}>
+        <label htmlFor={inputId} className={styles.legend}>
+          Recibido en efectivo
+        </label>
+        <MoneyInput
+          id={inputId}
+          value={receivedClp ?? ''}
+          onChange={(event) => {
+            onChange(toAmount(event.target.value));
+          }}
+        />
+      </div>
+      <div className={styles.chips} aria-label="Montos rápidos">
+        {cashShortcuts(dueClp).map((amount, index) => (
+          <Chip
+            key={amount}
+            pressed={receivedClp === amount}
+            onClick={() => {
+              onChange(amount);
+            }}
+            aria-label={
+              index === 0 ? `Exacto, ${formatClpSpoken(amount)}` : formatClpSpoken(amount)
+            }
+          >
+            {index === 0 ? 'Exacto' : formatClp(amount)}
+          </Chip>
+        ))}
+      </div>
+      {/* The change is shown in the footer; this only announces it. */}
+      <p className="visually-hidden" aria-live="polite">
+        {changeClp === null ? '' : `Vuelto: ${formatClpSpoken(changeClp)}`}
+      </p>
+    </div>
+  );
+}
