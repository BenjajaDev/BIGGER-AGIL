new file mode 100644
index 0000000..75c75d6
--- /dev/null
+++ b/apps/web/src/features/checks/payment-draft.test.ts
@@ -0,0 +1,117 @@
+import type { CheckLine } from '@bigger/shared';
+import {
+  cashShortcuts,
+  INITIAL_PAYMENT_DRAFT,
+  paymentBlocker,
+  paymentTotals,
+  selectWholeOrder,
+  toPaymentInput,
+  type PaymentDraft,
+} from './payment-draft';
+
+const line = (
+  orderItemId: string,
+  orderId: string,
+  unitTotalClp: number,
+  quantity: number,
+  paidQuantity = 0,
+): CheckLine => ({
+  orderId,
+  orderItemId,
+  productName: orderItemId,
+  unitTotalClp,
+  quantity,
+  paidQuantity,
+});
+
+// Juan: 2 cafés ($1.500) and a Luco ($3.990); Ana: a pie ($2.500).
+const check = {
+  balanceClp: 9490,
+  nextPartClp: null,
+  lines: [
+    line('cafe', 'juan', 1500, 2),
+    line('luco', 'juan', 3990, 1),
+    line('pie', 'ana', 2500, 1),
+  ],
+};
+
+const draft = (overrides: Partial<PaymentDraft>): PaymentDraft => ({
+  ...INITIAL_PAYMENT_DRAFT,
+  ...overrides,
+});
+
+describe('payment draft', () => {
+  it('charges the whole balance with a suggested 10 % tip and computes the change', () => {
+    expect(paymentTotals(check, draft({ method: 'cash', receivedClp: 20_000 }))).toEqual({
+      amountClp: 9490,
+      tipClp: 950,
+      dueClp: 10_440,
+      changeClp: 9560,
+    });
+  });
+
+  it('never adds a tip with JUNAEB and lets the tip be edited or removed', () => {
+    expect(paymentTotals(check, draft({ method: 'junaeb' })).tipClp).toBe(0);
+    expect(paymentTotals(check, draft({ method: 'debit', customTipClp: 2000 })).tipClp).toBe(2000);
+    expect(paymentTotals(check, draft({ method: 'debit', tipEnabled: false })).tipClp).toBe(0);
+  });
+
+  it('prices only the chosen units when someone pays their own items', () => {
+    const units = selectWholeOrder(check, {}, 'ana');
+    expect(units).toEqual({ pie: 1 });
+    const itemsDraft = draft({
+      mode: 'items',
+      units: { ...units, cafe: 1 },
+      method: 'debit',
+      tipEnabled: false,
+    });
+    expect(paymentTotals(check, itemsDraft).amountClp).toBe(4000);
+    expect(toPaymentInput(check, itemsDraft)).toEqual({
+      mode: 'items',
+      method: 'debit',
+      tipClp: 0,
+      receivedClp: null,
+      expectedAmountClp: 4000,
+      items: [
+        { orderItemId: 'pie', quantity: 1 },
+        { orderItemId: 'cafe', quantity: 1 },
+      ],
+    });
+  });
+
+  it('selects only what is still unpaid of a person’s order', () => {
+    const partlyPaid = {
+      lines: [line('cafe', 'juan', 1500, 2, 1), line('luco', 'juan', 3990, 1, 1)],
+    };
+    expect(selectWholeOrder(partlyPaid, {}, 'juan')).toEqual({ cafe: 1, luco: 0 });
+  });
+
+  it('says what is missing before the charge can be made', () => {
+    expect(paymentBlocker(check, draft({ mode: 'items' }))).toBe('Elige qué productos se pagan');
+    expect(paymentBlocker(check, draft({ mode: 'equal' }))).toBe('Elige en cuántas partes');
+    expect(paymentBlocker(check, draft({}))).toBe('Elige el medio de pago');
+    expect(paymentBlocker(check, draft({ method: 'cash', receivedClp: 5000 }))).toBe(
+      'Ingresa cuánto recibes: al menos $ 10.440',
+    );
+    expect(paymentBlocker(check, draft({ method: 'debit' }))).toBeNull();
+  });
+
+  it('charges the next equal part when the bill is split', () => {
+    const split = { ...check, nextPartClp: 4745 };
+    expect(
+      toPaymentInput(split, draft({ mode: 'equal', method: 'debit', tipEnabled: false })),
+    ).toEqual({
+      mode: 'equal',
+      method: 'debit',
+      tipClp: 0,
+      receivedClp: null,
+      expectedAmountClp: 4745,
+    });
+  });
+
+  it('offers the exact amount and the bills a customer usually hands over', () => {
+    expect(cashShortcuts(10_440)).toEqual([10_440, 11_000, 12_000, 15_000]);
+    expect(cashShortcuts(4000)).toEqual([4000, 5000, 10_000, 20_000]);
+    expect(cashShortcuts(0)).toEqual([]);
+  });
+});
diff --git a/apps/web/src/features/checks/payment-draft.ts b/apps/web/src/features/checks/payment-draft.ts
new file mode 100644
index 0000000..39e080d
--- /dev/null
+++ b/apps/web/src/features/checks/payment-draft.ts
@@ -0,0 +1,128 @@
+import {
+  suggestedTipClp,
+  type Check,
+  type CreatePaymentInput,
+  type PaymentMethod,
+  type PaymentMode,
+} from '@bigger/shared';
+import { formatClp } from '../../lib/format';
+
+/** What the cashier is filling in; every amount is derived from the live check. */
+export interface PaymentDraft {
+  mode: PaymentMode;
+  /** Units chosen per order line, for `items`. */
+  units: Readonly<Record<string, number>>;
+  method: PaymentMethod | null;
+  tipEnabled: boolean;
+  /** `null` keeps the suggested 10 %. */
+  customTipClp: number | null;
+  receivedClp: number | null;
+}
+
+export const INITIAL_PAYMENT_DRAFT: PaymentDraft = {
+  mode: 'full',
+  units: {},
+  method: null,
+  tipEnabled: true,
+  customTipClp: null,
+  receivedClp: null,
+};
+
+type CheckAmounts = Pick<Check, 'balanceClp' | 'nextPartClp' | 'lines'>;
+
+export function paymentAmountClp(check: CheckAmounts, draft: PaymentDraft): number {
+  switch (draft.mode) {
+    case 'full':
+      return check.balanceClp;
+    case 'equal':
+      return check.nextPartClp ?? 0;
+    case 'items':
+      return check.lines.reduce(
+        (sum, line) => sum + line.unitTotalClp * (draft.units[line.orderItemId] ?? 0),
+        0,
+      );
+  }
+}
+
+/** JUNAEB only covers food, so it never carries a tip. */
+export function tipAllowed(method: PaymentMethod | null): boolean {
+  return method !== 'junaeb';
+}
+
+export function paymentTipClp(amountClp: number, draft: PaymentDraft): number {
+  if (!draft.tipEnabled || !tipAllowed(draft.method)) return 0;
+  return draft.customTipClp ?? suggestedTipClp(amountClp);
+}
+
+export interface PaymentTotals {
+  amountClp: number;
+  tipClp: number;
+  dueClp: number;
+  /** Cash only, once enough was received. */
+  changeClp: number | null;
+}
+
+export function paymentTotals(check: CheckAmounts, draft: PaymentDraft): PaymentTotals {
+  const amountClp = paymentAmountClp(check, draft);
+  const tipClp = paymentTipClp(amountClp, draft);
+  const dueClp = amountClp + tipClp;
+  const changeClp =
+    draft.method === 'cash' && draft.receivedClp !== null && draft.receivedClp >= dueClp
+      ? draft.receivedClp - dueClp
+      : null;
+  return { amountClp, tipClp, dueClp, changeClp };
+}
+
+/** The first thing still missing before charging, in the words shown under the button. */
+export function paymentBlocker(check: CheckAmounts, draft: PaymentDraft): string | null {
+  const { amountClp, dueClp } = paymentTotals(check, draft);
+  if (draft.mode === 'items' && amountClp === 0) return 'Elige qué productos se pagan';
+  if (draft.mode === 'equal' && check.nextPartClp === null) return 'Elige en cuántas partes';
+  if (amountClp > check.balanceClp) return `Supera el saldo de ${formatClp(check.balanceClp)}`;
+  if (draft.method === null) return 'Elige el medio de pago';
+  if (draft.method === 'cash' && (draft.receivedClp ?? 0) < dueClp) {
+    return `Ingresa cuánto recibes: al menos ${formatClp(dueClp)}`;
+  }
+  return null;
+}
+
+export function toPaymentInput(check: CheckAmounts, draft: PaymentDraft): CreatePaymentInput {
+  const { amountClp, tipClp } = paymentTotals(check, draft);
+  const method = draft.method ?? 'cash';
+  const base = {
+    method,
+    tipClp,
+    receivedClp: method === 'cash' ? draft.receivedClp : null,
+    expectedAmountClp: amountClp,
+  };
+  if (draft.mode !== 'items') return { mode: draft.mode, ...base };
+  return {
+    mode: 'items',
+    ...base,
+    items: Object.entries(draft.units)
+      .filter(([, quantity]) => quantity > 0)
+      .map(([orderItemId, quantity]) => ({ orderItemId, quantity })),
+  };
+}
+
+const CASH_STEPS = [1000, 2000, 5000, 10_000, 20_000];
+
+/** Exact amount plus the bills a customer is likely to hand over. */
+export function cashShortcuts(dueClp: number): number[] {
+  if (dueClp <= 0) return [];
+  const rounded = CASH_STEPS.map((step) => Math.ceil(dueClp / step) * step);
+  return [...new Set([dueClp, ...rounded])].sort((a, b) => a - b).slice(0, 4);
+}
+
+/** Selects every unit still unpaid of one order ("Juan pays what he ordered"). */
+export function selectWholeOrder(
+  check: Pick<Check, 'lines'>,
+  units: Readonly<Record<string, number>>,
+  orderId: string,
+): Record<string, number> {
+  const next = { ...units };
+  for (const line of check.lines.filter((candidate) => candidate.orderId === orderId)) {
+    next[line.orderItemId] = line.quantity - line.paidQuantity;
+  }
+  return next;
+}
